APP_NAME=GeoPulse API
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Host-machine defaults (uvicorn/celery outside Docker).
# Docker Compose overrides these to use service hostnames (db, rabbitmq).
DATABASE_URL=postgresql+psycopg2://geopulse:geopulse@localhost:5432/geopulse

# Celery uses RabbitMQ (no Redis)
CELERY_BROKER_URL=amqp://geopulse:geopulse@localhost:5672//
CELERY_RESULT_BACKEND=db+postgresql+psycopg2://geopulse:geopulse@localhost:5432/geopulse

GDELT_LAST_UPDATE_URL=http://data.gdeltproject.org/gdeltv2/lastupdate.txt
GDELT_FETCH_INTERVAL_MINUTES=15

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_SUMMARY_ENABLED=false

WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
COUNTRIES_DATASET_URL=https://raw.githubusercontent.com/mledoze/countries/master/countries.json

# Optional production frontend publish port (used by ./up.sh prod)
# WEB_PORT=3000
